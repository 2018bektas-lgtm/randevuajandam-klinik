APP_NAME="Klinik Sitesi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8003

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Klinik public API (Kurumsal paket key)
RANDEVU_API_ENABLED=true
RANDEVU_API_PLATFORM=http://127.0.0.1:8001/api/v1
RANDEVU_API_BASE_URL=http://127.0.0.1:8001/api/v1/public/clinic
RANDEVU_API_PUBLIC_PATH=/public/clinic
RANDEVU_API_KEY=
RANDEVU_API_SECRET=
RANDEVU_MEDIA_BASE=http://127.0.0.1:8001/media
# Ana platform (paket yükseltme / upgrade linki)
RANDEVU_SITE_URL=http://127.0.0.1:8000
PLATFORM_PAKET_URL="${RANDEVU_SITE_URL}/hekim/paket-sec?degistir=1"
# Premium temalar (sicak, ocean). Klinik web paketi kurulumunda true bırakın.
THEMES_PREMIUM_UNLOCKED=true

WEBHOOK_RECEIVER_SECRET=

LOCAL_ADMIN_EMAIL=admin@klinik.local
LOCAL_ADMIN_PASSWORD=admin123
LOCAL_ADMIN_AUTO_CREATE=true

# Google reCAPTCHA v3 (opsiyonel; panel de girilebilir)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_SOFT_FAIL=true

